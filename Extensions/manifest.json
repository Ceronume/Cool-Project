{
    "manifest_version": 3,
    "name": "To-Do List",
    "description": "A simple and clean to-do list extension! Coded by CodeHack.",
    "version": "1.0",
    "action": {
        "default_popup": "to-do-list.html"
    },
    "permissions": [
        "storage"
    ],
    "icons": {
        "16": "image/icon16.png",
        "32": "image/icon32.png",
        "128": "image/icon128.png"
    }
}